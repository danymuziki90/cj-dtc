generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums convertis en String pour SQLite
// enum Role {
//   ADMIN
//   STUDENT
// }

// enum StudentStatus {
//   PENDING
//   ACTIVE
//   SUSPENDED
// }

model Student {
  id            String  @id @default(cuid())
  firstName     String
  lastName      String
  email         String  @unique
  username      String? @unique
  password      String
  phone         String?
  studentNumber String  @unique
  status        String  @default("ACTIVE")
  role          String  @default("STUDENT")

  // Additional fields from registration form
  dateOfBirth DateTime?
  address     String?
  city        String?
  country     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  enrollments         Enrollment[]
  certificates        Certificate[]
  Submission          Submission[]
  Testimonial         Testimonial[]

  @@index([username])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique @default("")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model AdminNotification {
  id           String   @id @default(cuid())
  title        String
  message      String
  type         String   @default("info")
  target       String   @default("all") // all, student, session
  studentEmail String?
  sessionId    Int?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([target])
  @@index([studentEmail])
  @@index([sessionId])
  @@index([createdAt])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  adminId       String?
  adminUsername String
  action        String
  targetType    String
  targetId      String?
  targetLabel   String?
  summary       String
  status        String   @default("success")
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model News {
  id              String   @id @default(cuid())
  title           String
  titleEn         String?
  content         String
  contentEn       String?
  published       Boolean  @default(false)
  author          String   @default("Admin")
  category        String   @default("General")
  tags            String   @default("")
  imageData       String?
  publicationDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metadata        Json?

  @@index([published])
  @@index([publicationDate])
  @@index([category])
}

model Formation {
  id                 Int               @id @default(autoincrement())
  name               String?
  title              String
  titleEn            String?
  slug               String            @unique
  description        String
  descriptionEn      String?
  shortDescription   String?
  shortDescriptionEn String?
  objectifs          String?
  objectifsEn        String?
  duree              String?
  modules            String?
  modulesEn          String?
  methodes           String?
  methodesEn         String?
  certification      String?
  certificationEn    String?
  categorie          String?
  statut             String            @default("brouillon") // brouillon, publie, archive
  imageUrl           String?
  gallery            Json?
  skillsAcquired     Json?
  prerequisites      String?
  prerequisitesEn    String?
  publicTargets      Json?
  level              String?
  format             String?
  languages          Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  certificates       Certificate[]
  enrollments        Enrollment[]
  sessions           TrainingSession[]
  documents          Document[]
  evaluations        Evaluation[]
  Assignment         Assignment[]
  Testimonial        Testimonial[]
}

model Certificate {
  id           Int              @id @default(autoincrement())
  code         String           @unique
  type         String           @default("completion") // completion, attendance, excellence
  holderName   String
  formation    Formation?       @relation(fields: [formationId], references: [id])
  formationId  Int?
  sessionId    Int?
  session      TrainingSession? @relation(fields: [sessionId], references: [id])
  enrollmentId Int?             @unique
  enrollment   Enrollment?      @relation(fields: [enrollmentId], references: [id])
  issuedAt     DateTime         @default(now())
  verified     Boolean          @default(false)
  issuedBy     String?
  fileUrl      String?
  status       String           @default("actif") // actif, archive, revoque
  studentId    String?
  student      Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  User         User?            @relation(fields: [userId], references: [id])
  userId       String?

  @@index([formationId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([studentId])
  @@index([type])
}

model Enrollment {
  id               Int              @id @default(autoincrement())
  studentId        String?
  student          Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  email            String
  phone            String?
  address          String?
  matricule        String?          @unique
  formationId      Int
  formation        Formation        @relation(fields: [formationId], references: [id], onDelete: Cascade)
  sessionId        Int?
  session          TrainingSession? @relation(fields: [sessionId], references: [id])
  startDate        DateTime
  status           String           @default("pending") // pending, accepted, confirmed, rejected, cancelled, completed
  motivationLetter String?
  notes            String?

  waitlist    Waitlist[]
  attendances Attendance[]
  formAnswers SessionFormAnswer[]

  // Certificats
  certificateIssued Boolean      @default(false)
  certificateId     Int?         @unique
  certificate       Certificate?

  // Évaluations
  evaluation Evaluation?

  // Relances automatiques
  lastReminderSent DateTime?
  reminderCount    Int       @default(0)
  nextReminderDate DateTime?

  // Analytics et suivi
  source           String? // website, social_media, referral, search_engine, advertisement, other
  sourceDetails    String? // détails supplémentaires sur l'origine
  employmentStatus String? // employed, unemployed, student, self_employed, other
  insertionResult  String? // placed, not_placed, pending (pour le suivi d'insertion professionnelle)
  insertionDate    DateTime?
  insertionNotes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formationId])
  @@index([studentId])
  @@index([sessionId])
  @@index([email])
  @@index([startDate])
  @@index([status])
  @@index([source])
}

model TrainingSession {
  id                  Int                   @id @default(autoincrement())
  formationId         Int
  formation           Formation             @relation(fields: [formationId], references: [id], onDelete: Cascade)
  startDate           DateTime
  endDate             DateTime
  startTime           String
  endTime             String
  location            String?               @map("locationDetails")
  locationEn          String?
  format              String                @map("mode") // presentiel, distanciel, hybride
  formatEn            String?
  maxParticipants     Int                   @default(25)
  currentParticipants Int                   @default(0)
  status              String                @default("ouverte") // ouverte, fermee, complete, annulee, terminee
  description         String?
  prerequisites       String?
  objectives          String?
  imageUrl            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  enrollments         Enrollment[]
  instructors         SessionInstructor[]
  documents           Document[]
  evaluations         Evaluation[]
  certificates        Certificate[]
  waitlist            Waitlist[]
  attendances         Attendance[]
  events              SessionEvent[]
  formQuestions       SessionFormQuestion[]
  Assignment          Assignment[]
  Submission          Submission[]
  Testimonial         Testimonial[]

  @@index([formationId])
  @@index([startDate])
  @@index([status])
}

model Instructor {
  id         Int                 @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String              @unique
  phone      String?
  bio        String?
  expertise  String? // domaines d'expertise
  experience String? // années d'expérience
  photoUrl   String?
  status     String              @default("active") // active, inactive
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  sessions   SessionInstructor[]

  @@index([email])
  @@index([status])
}

model SessionInstructor {
  id           Int             @id @default(autoincrement())
  sessionId    Int
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  instructorId Int
  instructor   Instructor      @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  role         String          @default("formateur") // formateur, assistant, examinateur
  createdAt    DateTime        @default(now())

  @@unique([sessionId, instructorId])
  @@index([sessionId])
  @@index([instructorId])
}

model Document {
  id            Int              @id @default(autoincrement())
  title         String
  titleEn       String?
  description   String?
  descriptionEn String?
  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String
  formationId   Int?
  formation     Formation?       @relation(fields: [formationId], references: [id])
  sessionId     Int?
  session       TrainingSession? @relation(fields: [sessionId], references: [id])
  category      String // syllabus, presentation, exercise, resource, certificate_template
  isPublic      Boolean          @default(false)
  uploadedBy    String? // user ID
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([formationId])
  @@index([sessionId])
  @@index([category])
  @@index([isPublic])
}

model Evaluation {
  id           Int              @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionId    Int?
  session      TrainingSession? @relation(fields: [sessionId], references: [id])
  formationId  Int
  formation    Formation        @relation(fields: [formationId], references: [id])

  // Évaluation globale
  overallRating  Int // 1-5 étoiles
  overallComment String?

  // Évaluation détaillée
  contentRating      Int? // qualité du contenu
  instructorRating   Int? // qualité du formateur
  materialRating     Int? // qualité des supports
  organizationRating Int? // organisation
  facilityRating     Int? // locaux/équipements

  // Questions ouvertes
  strengths       String?
  improvements    String?
  recommendations String?

  // Métadonnées
  submittedAt DateTime @default(now())
  isAnonymous Boolean  @default(false)

  @@unique([enrollmentId])
  @@index([formationId])
  @@index([sessionId])
  @@index([overallRating])
}

model Waitlist {
  id           Int             @id @default(autoincrement())
  sessionId    Int
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId Int
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  position     Int
  addedAt      DateTime        @default(now())
  notifiedAt   DateTime?

  @@unique([sessionId, enrollmentId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([position])
}

model Attendance {
  id           Int             @id @default(autoincrement())
  sessionId    Int
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId Int
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime
  status       String // present, absent, late, excused
  notes        String?
  recordedAt   DateTime        @default(now())
  recordedBy   String? // user ID

  @@unique([sessionId, enrollmentId, date])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([date])
  @@index([status])
}

model B2BRequest {
  id          Int      @id @default(autoincrement())
  company     String
  contactName String
  position    String?
  email       String
  phone       String?
  sector      String?
  employees   String?
  needType    String
  message     String?
  status      String   @default("pending") // pending, contacted, qualified, archived
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("unread") // unread, read, replied, archived
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model FAQ {
  id         Int      @id @default(autoincrement())
  question   String
  questionEn String?
  answer     String
  answerEn   String?
  category   String   @default("General")
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([category])
}

model SessionEvent {
  id          Int             @id @default(autoincrement())
  sessionId   Int
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  startTime   String // ex. "09:00"
  endTime     String // ex. "12:00"
  type        String // "class", "exam", "meeting", "other"
  location    String? // zoom link, room number
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sessionId])
  @@index([date])
}

// =============================================
// FORMULAIRE D'INSCRIPTION PERSONNALISÉ
// =============================================

model SessionFormTemplate {
  id          Int                   @id @default(autoincrement())
  name        String
  description String?
  questions   SessionFormQuestion[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model SessionFormQuestion {
  id         Int                  @id @default(autoincrement())
  sessionId  Int
  session    TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templateId Int?
  template   SessionFormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  label      String
  labelEn    String?
  type       String // text_short | text_long | number | date | select | radio | checkbox | yes_no | file_upload
  helpText   String?
  helpTextEn String?
  required   Boolean  @default(false)
  order      Int      @default(0)
  options    String? // JSON array ["Option A", "Option B"] pour select/radio/checkbox
  fileTypes  String? // JSON array ["pdf","docx"] pour file_upload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  answers SessionFormAnswer[]

  @@index([sessionId])
  @@index([order])
  @@index([templateId])
}

model SessionFormAnswer {
  id           Int                 @id @default(autoincrement())
  questionId   Int
  question     SessionFormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  enrollmentId Int
  enrollment   Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  textValue String? // text_short, text_long, date, yes_no, number
  jsonValue String? // JSON array pour checkbox
  fileUrl   String? // file_upload stockage URL
  fileName  String? // nom original du fichier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, enrollmentId])
  @@index([questionId])
  @@index([enrollmentId])
}

model EmailTemplate {
  id        String   @id // e.g. "accepted", "rejected", "waitlist", "cancelled"
  subject   String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model Assignment {
  id                Int              @id @default(autoincrement())
  title             String
  titleEn           String?
  description       String
  descriptionEn     String?
  type              String           @default("tp")
  formationId       Int
  deadline          DateTime
  maxFileSize       Int              @default(10)
  allowedFileTypes  String           @default("pdf,doc,docx,zip,rar,png,jpg,jpeg,excel,xls,xlsx")
  instructions      String?
  instructionsEn    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessionId         Int?
  difficulty        String?          @default("intermediaire")
  objectives        String?
  published         Boolean          @default(true)
  publishedAt       DateTime         @default(now())
  allowResubmission Boolean          @default(true)
  maxFiles          Int              @default(5)
  status            String           @default("publie")
  maxGrade          Float            @default(100)
  Formation         Formation        @relation(fields: [formationId], references: [id], onDelete: Cascade)
  TrainingSession   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  AssignmentFile    AssignmentFile[]
  Submission        Submission[]

  @@index([deadline])
  @@index([formationId])
  @@index([published])
  @@index([sessionId])
  @@index([status])
}

model AssignmentFile {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  name         String
  originalName String
  size         Int
  url          String
  createdAt    DateTime   @default(now())
  key          String?
  mimeType     String     @default("application/octet-stream")
  Assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

model LMSConfig {
  id        Int      @id @default(autoincrement())
  provider  String
  apiUrl    String?
  apiKey    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id               Int              @id @default(autoincrement())
  assignmentId     Int
  status           String           @default("submitted")
  grade            Float?
  maxGrade         Float            @default(100)
  percentage       Float?
  feedback         String?
  internalNote     String?
  correctionStatus String           @default("pending") // pending | in_review | graded | returned | validated
  submittedAt      DateTime         @default(now())
  gradedAt         DateTime?
  gradedBy         String?
  createdAt        DateTime         @default(now())
  sessionId        Int?
  studentId        String
  updatedAt        DateTime         @updatedAt
  Assignment       Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  TrainingSession  TrainingSession? @relation(fields: [sessionId], references: [id])
  Student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  SubmissionFile   SubmissionFile[]

  @@index([assignmentId])
  @@index([sessionId])
  @@index([status])
  @@index([correctionStatus])
  @@index([studentId])
}

model SubmissionFile {
  id           Int        @id @default(autoincrement())
  submissionId Int
  name         String
  originalName String
  size         Int
  mimeType     String     @default("application/octet-stream")
  url          String
  uploadedAt   DateTime   @default(now())
  key          String?
  Submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Testimonial {
  id              Int              @id @default(autoincrement())
  createdAt       DateTime         @default(now())
  adminReply      String?
  formationId     Int?
  rating          Int
  sessionId       Int?
  status          String           @default("pending")
  studentId       String
  title           String?
  titleEn         String?
  updatedAt       DateTime         @updatedAt
  adminNote       String?
  content         String
  contentEn       String?
  Formation       Formation?       @relation(fields: [formationId], references: [id])
  TrainingSession TrainingSession? @relation(fields: [sessionId], references: [id])
  Student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([formationId])
  @@index([sessionId])
  @@index([status])
  @@index([studentId])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String        @default("STUDENT")
  createdAt     DateTime      @default(now())
  Account       Account[]
  Certificate   Certificate[]
  Session       Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?
  User               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// =============================================
// HERO SECTIONS — Images & contenus dynamiques
// =============================================

model HeroSection {
  id       String  @id @default(cuid())
  /// Identifiant de page unique: home | about | sessions | entreprises | actualites | contact | emplois | galerie | partenaires
  pageKey  String  @unique
  isActive Boolean @default(true)

  // Image principale
  imageUrl        String?
  imageAlt        String?
  /// URL de l'image par défaut (fallback statique, jamais supprimée)
  defaultImageUrl String?

  // Contenu FR
  eyebrowFr     String?
  titleFr       String  @default("")
  descriptionFr String?

  // Contenu EN
  eyebrowEn     String?
  titleEn       String  @default("")
  descriptionEn String?

  // CTAs JSON: [{label, href, variant}]
  ctasFr Json?
  ctasEn Json?

  // Badges JSON: [{label, color}]
  badgesFr Json?
  badgesEn Json?

  // Options d'affichage
  overlayOpacity  Int     @default(55)
  compact         Boolean @default(false)
  /// Active le défilement automatique lorsqu'au moins deux slides sont publiés.
  carouselEnabled Boolean @default(true)
  /// Durée d'affichage d'un slide, en millisecondes.
  slideDuration   Int     @default(6000)

  // Slides du carrousel (homepage uniquement)
  slides HeroSlide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageKey])
  @@index([isActive])
}

model HeroSlide {
  id       String      @id @default(cuid())
  heroId   String
  hero     HeroSection @relation(fields: [heroId], references: [id], onDelete: Cascade)
  order    Int         @default(0)
  /// Permet de retirer un slide du carrousel sans le supprimer.
  isActive Boolean     @default(true)

  imageUrl      String
  imageAlt      String?
  eyebrowFr     String?
  eyebrowEn     String?
  titleFr       String  @default("")
  titleEn       String  @default("")
  descriptionFr String?
  descriptionEn String?
  badgeFr       String?
  badgeEn       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([heroId])
  @@index([order])
}
